# Copy this file to ".env" and fill in your OpenRouter API key.
# The ".env" file is gitignored and will never be committed.

# Required: your OpenRouter API key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: override the API base URL. Any OpenAI-compatible endpoint works.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional: override the default models (CLI flags take precedence over these).
# FUSION_PANEL_MODELS=openai/gpt-6-luna,anthropic/claude-haiku-5.5,deepseek/deepseek-v4.1-flash-1017
# FUSION_JUDGE_MODEL=openai/gpt-6.1-terra
# FUSION_SYNTH_MODEL=openai/gpt-6.1-terra
